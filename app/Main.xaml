<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LumaRelay" Width="920" Height="730" MinWidth="740" MinHeight="620"
        Background="#10171C" Foreground="#E8F0F1" FontFamily="Segoe UI"
        FontSize="14" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="Detail" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="#B3C1C4"/><Setter Property="FontSize" Value="14"/><Setter Property="LineHeight" Value="21"/></Style>
    <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="21"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#E6F0EF"/><Setter Property="Background" Value="#26353C"/><Setter Property="BorderBrush" Value="#36474D"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#102725"/><Setter Property="Background" Value="#8FE6D0"/><Setter Property="BorderBrush" Value="#A2F1DE"/>
    </Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#172127"/><Setter Property="BorderBrush" Value="#2C3A41"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
    <Style TargetType="TextBox"><Setter Property="Foreground" Value="#EBF3F3"/><Setter Property="Background" Value="#10191F"/><Setter Property="BorderBrush" Value="#45585E"/><Setter Property="Padding" Value="9,7"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="69"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border BorderBrush="#2A373E" BorderThickness="0,0,0,1" Padding="30,0">
      <DockPanel LastChildFill="False" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
          <Path Fill="#8FE6D0" Width="28" Height="25" Stretch="Uniform" Data="M0,23 L10,1 L15,1 L5,23 Z M10,23 L18,6 L22,6 L17,18 L28,18 L26,23 Z"/>
          <TextBlock Text="LumaRelay" FontWeight="SemiBold" FontSize="24" Margin="9,-2,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <Button Name="PlayNav" Content="Play"/><Button Name="HostNav" Content="Host"/><Button Name="ClientNav" Content="Client" Margin="0"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid Name="Pages" Margin="30,22,30,12">
        <StackPanel Name="PlayPage">
          <Border Height="205" CornerRadius="12" Margin="0,0,0,18">
            <Border.Background><ImageBrush x:Name="HeroBrush" Stretch="UniformToFill"/></Border.Background>
            <Grid>
              <Border CornerRadius="12"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#DD081519" Offset="0"/><GradientStop Color="#A8081519" Offset="0.43"/><GradientStop Color="#00081519" Offset="0.83"/></LinearGradientBrush></Border.Background></Border>
              <StackPanel Margin="25,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                <TextBlock Name="HeroTitle" Text="PS Remote Play" FontSize="36" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock Name="HeroDetail" Text="Play through your existing Sony connection." Margin="0,4,0,18" Foreground="#D8E6E5"/>
                <Button Name="OpenSource" Content="Open Remote Play" HorizontalAlignment="Left" Style="{StaticResource Primary}"/>
              </StackPanel>
            </Grid>
          </Border>
          <TextBlock Text="Video source" Style="{StaticResource Heading}"/>
          <UniformGrid Columns="3" Margin="0,0,-8,18">
            <Button Name="Sony" Content="PS Remote Play"/><Button Name="Direct" Content="Direct to PS5"/><Button Name="Demo" Content="Arcade demo"/>
          </UniformGrid>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Picture" Style="{StaticResource Heading}"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,15,0"><TextBlock Text="Upscaling" Foreground="#B3C1C4" Margin="0,0,0,5"/><ComboBox Name="Mode" Padding="6,5"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,15,0"><TextBlock Text="Frame interpolation" Foreground="#B3C1C4" Margin="0,0,0,5"/><ComboBox Name="Multiplier" Padding="6,5"/></StackPanel>
                <Button Grid.Column="2" Name="Enhance" Content="Open enhanced view" VerticalAlignment="Bottom" Margin="0"/>
              </Grid>
              <TextBlock Name="PictureHint" Style="{StaticResource Detail}" Margin="0,12,0,0" Text="Open the view after your game is visible. Ctrl+Alt+B compares the picture. Ctrl+Alt+Q exits."/>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Name="HostPage" Visibility="Collapsed">
          <TextBlock Text="Host a session" FontSize="34" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <TextBlock Style="{StaticResource Detail}" Text="Share this PC’s desktop and audio with a paired client. Sharing continues until you select Stop sharing." Margin="0,0,0,18"/>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="Listen on this PC" Style="{StaticResource Heading}"/>
            <TextBlock Text="Home network or private VPN address" Style="{StaticResource Detail}" Margin="0,0,0,6"/>
            <ComboBox Name="BindIP" Padding="6" MaxWidth="460" HorizontalAlignment="Left" MinWidth="260"/>
            <WrapPanel Margin="0,14,0,0"><Button Name="StartHost" Style="{StaticResource Primary}" Content="Start sharing"/><Button Name="StopHost" Content="Stop sharing"/><Button Name="HostStatus" Content="Check status"/></WrapPanel>
            <TextBlock Name="HostState" Style="{StaticResource Detail}" Margin="0,12,0,0" Text="Check status to see the current host state."/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="Pair a client" Style="{StaticResource Heading}"/>
            <TextBlock Style="{StaticResource Detail}" Text="On the other device, open Client and request pairing. Enter its four-digit PIN here." Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal"><TextBox Name="Pin" MaxLength="4" Width="88" Margin="0,0,10,0"/><Button Name="ApprovePin" Content="Approve PIN"/></StackPanel>
          </StackPanel></Border>
          <Expander Header="Manage paired clients" Foreground="#C7D8D8" Margin="0,0,0,14">
            <WrapPanel Margin="4,10,0,0">
              <Button Name="LoadPeers" Content="Load devices"/>
              <ComboBox Name="Peers" DisplayMemberPath="Name" SelectedValuePath="Id" MinWidth="158" MaxWidth="260" Margin="0,0,8,0" Padding="6"/>
              <Button Name="RemovePeer" Content="Revoke access"/>
            </WrapPanel>
          </Expander>
          <Button Name="Controllers" Content="Controller driver setup ↗" HorizontalAlignment="Left"/>
        </StackPanel>
        <StackPanel Name="ClientPage" Visibility="Collapsed">
          <TextBlock Text="Connect to your host" FontSize="34" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <TextBlock Style="{StaticResource Detail}" Text="Play from another Windows PC. Use the host’s LAN address at home, or its private VPN address when you’re away." Margin="0,0,0,18"/>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="Host address" Style="{StaticResource Heading}"/>
            <TextBox Name="HostAddress" Width="300" HorizontalAlignment="Left"/>
            <WrapPanel Margin="0,15,0,0"><Button Name="ClientPair" Content="Pair with host"/><Button Name="ClientPlay" Style="{StaticResource Primary}" Content="Start stream"/></WrapPanel>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="Stream quality" Style="{StaticResource Heading}"/>
            <ComboBox Name="Quality" HorizontalAlignment="Left" MinWidth="320" Padding="6" Margin="0,0,0,10"/>
            <TextBlock Style="{StaticResource Detail}" Text="Pick a profile your network and display can sustain. For custom bitrate, HDR, and audio settings, use Moonlight." Margin="0,0,0,12"/>
            <Button Name="OpenClient" Content="Open Moonlight" HorizontalAlignment="Left"/>
          </StackPanel></Border>
          <Button Name="DirectClient" Content="Play directly from my PS5" HorizontalAlignment="Left"/>
        </StackPanel>
      </Grid>
    </ScrollViewer>
    <Border Grid.Row="2" Padding="30,11" Background="#121D22" BorderBrush="#293940" BorderThickness="0,1,0,0">
      <DockPanel><Ellipse Name="Indicator" DockPanel.Dock="Left" Width="8" Height="8" Fill="#91DECA" Margin="0,0,10,0"/><TextBlock Name="Status" Text="Ready" Foreground="#CAD8D9" FontSize="13" MaxHeight="100" TextTrimming="CharacterEllipsis"/></DockPanel>
    </Border>
  </Grid>
</Window>
