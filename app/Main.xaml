<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="P5Cast" Width="1320" Height="860" MinWidth="880" MinHeight="590"
        Background="#10171C" Foreground="#E8F0F1" FontFamily="Segoe UI"
        FontSize="14" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="WipeSlider" TargetType="Slider">
      <Setter Property="Height" Value="22"/><Setter Property="Margin" Value="2,2"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
        <Grid Background="Transparent">
          <Border Height="3" Margin="5,0" CornerRadius="1.5" Background="#4B6266"/>
          <Track x:Name="PART_Track" Orientation="Horizontal">
            <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False" Opacity="0"/></Track.DecreaseRepeatButton>
            <Track.Thumb><Thumb Width="12" Height="16" Cursor="SizeWE"><Thumb.Template><ControlTemplate TargetType="Thumb">
              <Border CornerRadius="5" Background="#8FE6D0" BorderThickness="1" BorderBrush="#B9EEDF"/>
            </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False" Opacity="0"/></Track.IncreaseRepeatButton>
          </Track>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="TitleAction" TargetType="ButtonBase">
      <Setter Property="Foreground" Value="#D6E2E2"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="MinWidth" Value="38"/><Setter Property="Padding" Value="9,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ButtonBase">
        <Grid Background="Transparent">
          <Border Name="ButtonFace" Height="34" VerticalAlignment="Center" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonFace" Property="Background" Value="#304147"/></Trigger>
          <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="Tag" Value="Close"/></MultiTrigger.Conditions><Setter TargetName="ButtonFace" Property="Background" Value="#A63E47"/></MultiTrigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonFace" Property="Opacity" Value="0.7"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonFace" Property="BorderBrush" Value="#8FE6D0"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="Detail" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="#B3C1C4"/><Setter Property="FontSize" Value="14"/><Setter Property="LineHeight" Value="21"/></Style>
    <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="21"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,6"/><Setter Property="MinHeight" Value="32"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Foreground" Value="#E6F0EF"/><Setter Property="Background" Value="#26353C"/><Setter Property="BorderBrush" Value="#36474D"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid>
          <Border x:Name="Surface" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
          <Border Name="Wash" CornerRadius="7" Margin="1" Background="White" Opacity="0"/>
          <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Wash" Property="Opacity" Value="0.08"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Wash" Property="Background" Value="Black"/><Setter TargetName="Wash" Property="Opacity" Value="0.14"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#ADFAE6"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.48"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#102725"/><Setter Property="Background" Value="#8FE6D0"/><Setter Property="BorderBrush" Value="#A2F1DE"/>
    </Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#172127"/><Setter Property="BorderBrush" Value="#2C3A41"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
    <Style x:Key="GroupRail" TargetType="Border">
      <Setter Property="Background" Value="#111B20"/><Setter Property="BorderBrush" Value="#304048"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="9"/><Setter Property="Padding" Value="3"/><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style x:Key="GroupTab" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="#ADBDC0"/>
      <Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="10,3"/><Setter Property="MinHeight" Value="28"/><Setter Property="Margin" Value="0"/>
      <Style.Triggers>
        <Trigger Property="AutomationProperties.ItemStatus" Value="Selected">
          <Setter Property="Background" Value="#264039"/><Setter Property="BorderBrush" Value="#42665B"/><Setter Property="Foreground" Value="#B7F3DF"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="14"/><Setter Property="Background" Value="Transparent"/><Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
          <Track Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
            <Track.DecreaseRepeatButton><RepeatButton Name="Before" Style="{StaticResource ScrollPage}" Command="{x:Static ScrollBar.PageUpCommand}"/></Track.DecreaseRepeatButton>
            <Track.Thumb>
              <Thumb Name="Grip" Background="#50646A" Focusable="False">
                <Thumb.Template><ControlTemplate TargetType="Thumb">
                  <Grid Background="Transparent"><Border Name="Pill" CornerRadius="4" Margin="4,2" Background="{TemplateBinding Background}"/></Grid>
                  <ControlTemplate.Triggers>
                    <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="Horizontal"><Setter TargetName="Pill" Property="Margin" Value="2,4"/></DataTrigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="Background" Value="#87A4A6"/></Trigger>
                    <Trigger Property="IsDragging" Value="True"><Setter TargetName="Pill" Property="Background" Value="#8FE6D0"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate></Thumb.Template>
              </Thumb>
            </Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton Name="After" Style="{StaticResource ScrollPage}" Command="{x:Static ScrollBar.PageDownCommand}"/></Track.IncreaseRepeatButton>
          </Track>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="Orientation" Value="Horizontal">
            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
            <Setter TargetName="Before" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/><Setter TargetName="After" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Height" Value="14"/><Setter Property="Width" Value="Auto"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="ScrollViewer">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollViewer">
        <Grid Background="{TemplateBinding Background}">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <ScrollContentPresenter Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}" CanContentScroll="{TemplateBinding CanContentScroll}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
          <ScrollBar Name="PART_VerticalScrollBar" Style="{StaticResource {x:Type ScrollBar}}" Grid.Column="1" Orientation="Vertical" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
            Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"/>
          <ScrollBar Name="PART_HorizontalScrollBar" Style="{StaticResource {x:Type ScrollBar}}" Grid.Row="1" Orientation="Horizontal" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
            Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}" Value="{Binding HorizontalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"/>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#EBF3F3"/><Setter Property="Background" Value="#121D23"/><Setter Property="BorderBrush" Value="#3B4F56"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,5"/><Setter Property="MinHeight" Value="32"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="CaretBrush" Value="#C2F5E9"/><Setter Property="SelectionBrush" Value="#4A786D"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
          <ScrollViewer Name="PART_ContentHost" Focusable="False" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#688287"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#8FE6D0"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.48"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#D5E1E1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <StackPanel Orientation="Horizontal" Background="Transparent">
          <Border Name="Box" Width="17" Height="17" CornerRadius="5" Background="#152229" BorderBrush="#5A7075" BorderThickness="1" VerticalAlignment="Center">
            <Path Name="Tick" Visibility="Hidden" Width="10" Height="8" Stretch="Uniform" Stroke="#152923" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M1,4 L4,7 L10,1"/>
          </Border>
          <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </StackPanel>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#96ADA9"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Tick" Property="Visibility" Value="Visible"/><Setter TargetName="Box" Property="Background" Value="#8FE6D0"/><Setter TargetName="Box" Property="BorderBrush" Value="#8FE6D0"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="White"/><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.48"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#E6F0EF"/><Setter Property="Padding" Value="9,6"/><Setter Property="Margin" Value="0,1"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
        <Border Name="Item" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="5"><ContentPresenter/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#28443F"/></Trigger>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#324950"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.46"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#E6F0EF"/><Setter Property="MinHeight" Value="32"/><Setter Property="MaxDropDownHeight" Value="320"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <Border Name="Field" Background="#1B292F" BorderBrush="#3B4F56" BorderThickness="1" CornerRadius="7"/>
          <ToggleButton Focusable="False" ClickMode="Press" Cursor="Hand" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" CornerRadius="7"/></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <Grid IsHitTestVisible="False" Margin="10,3">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/></Grid.ColumnDefinitions>
            <ContentPresenter VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
            <Path Grid.Column="1" Data="M 1,2 L 5,6 L 9,2" Stroke="#B7C9CB" StrokeThickness="1.5" VerticalAlignment="Center"/>
          </Grid>
          <Popup Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" VerticalOffset="3">
            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}" CornerRadius="8" BorderBrush="#476069" BorderThickness="1" Background="#1A272E" Padding="4">
              <ScrollViewer Style="{StaticResource {x:Type ScrollViewer}}" CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#688287"/></Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#8FE6D0"/></Trigger>
          <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#8FE6D0"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Field" Property="Background" Value="#152127"/><Setter Property="Opacity" Value="0.55"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid Name="WindowFrame">
    <Grid Name="InterfaceRoot">
    <Grid.RowDefinitions><RowDefinition Name="HeaderRow" Height="52"/><RowDefinition Height="*"/><RowDefinition Name="StatusRow" Height="Auto"/></Grid.RowDefinitions>
    <Border Name="HeaderBar" Background="#152026" BorderBrush="#2A393E" BorderThickness="0,0,0,1">
      <Border.Style><Style TargetType="Border">
        <Setter Property="Padding" Value="16,6,6,6"/>
        <Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
          <Setter Property="Padding" Value="16,0,0,0"/>
        </DataTrigger></Style.Triggers>
      </Style></Border.Style>
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
          <Image Width="26" Height="26" Stretch="Uniform" Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}"/>
          <TextBlock Text="P5Cast" FontWeight="SemiBold" FontSize="19" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Name="PlayNav" Content="Play" Style="{StaticResource TitleAction}" MinWidth="58"/>
          <Button Name="HostNav" Content="Host" Style="{StaticResource TitleAction}" MinWidth="58"/>
          <Button Name="ClientNav" Content="Client" Style="{StaticResource TitleAction}" MinWidth="58"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <ToggleButton Name="ShowStats" Style="{StaticResource TitleAction}" AutomationProperties.Name="Performance sidebar">
            <Canvas Width="22" Height="22" IsHitTestVisible="False">
              <Line Name="MenuTop" X1="2" X2="20" Y1="11" Y2="11" Stroke="#8FE6D0" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                <Line.RenderTransform><TransformGroup><RotateTransform CenterX="11" CenterY="11"/><TranslateTransform Y="-3"/></TransformGroup></Line.RenderTransform>
              </Line>
              <Line Name="MenuBottom" X1="2" X2="20" Y1="11" Y2="11" Stroke="#8FE6D0" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                <Line.RenderTransform><TransformGroup><RotateTransform CenterX="11" CenterY="11"/><TranslateTransform Y="3"/></TransformGroup></Line.RenderTransform>
              </Line>
            </Canvas>
          </ToggleButton>
          <Border Background="#354449" Width="1" Height="18" Margin="6,0"/>
          <Button Name="MinimizeWindow" Style="{StaticResource TitleAction}" ToolTip="Minimize" AutomationProperties.Name="Minimize"><Path Stroke="#C5D3D4" StrokeThickness="1.2" Data="M0,5 H10"/></Button>
          <Button Name="MaximizeWindow" Style="{StaticResource TitleAction}" ToolTip="Maximize" AutomationProperties.Name="Maximize"><Path Name="MaximizeGlyph" Stroke="#C5D3D4" StrokeThickness="1.2" Data="M0,0 H10 V10 H0 Z"/></Button>
          <Button Name="CloseWindow" Tag="Close" Style="{StaticResource TitleAction}" ToolTip="Close" AutomationProperties.Name="Close P5Cast"><Path Stroke="#E4EEEE" StrokeThickness="1.25" Data="M0,0 L10,10 M10,0 L0,10"/></Button>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Name="Workspace" Grid.Row="1" Margin="16,14,16,12">
      <Grid.Resources>
        <Style x:Key="DrawerGrip" TargetType="Thumb">
          <Setter Property="Focusable" Value="True"/><Setter Property="IsTabStop" Value="True"/>
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
            <Grid Background="Transparent">
              <Border Name="Grip" Width="36" Height="3" CornerRadius="2" Background="#516168" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Tag" Value="Vertical"><Setter TargetName="Grip" Property="Width" Value="3"/><Setter TargetName="Grip" Property="Height" Value="36"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#93BCB3"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Grip" Property="Background" Value="#8FE6D0"/></Trigger>
              <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="#8FE6D0"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate></Setter.Value></Setter>
        </Style>
      </Grid.Resources>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Name="MeterColumn" Width="Auto"/></Grid.ColumnDefinitions>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Name="TransportRow" Height="52"/><RowDefinition Name="SettingsRow" Height="Auto"/></Grid.RowDefinitions>
        <Border Name="VideoHost" Background="Black" ClipToBounds="True"/>
        <DockPanel Name="TransportBar" Grid.Row="1" LastChildFill="False" VerticalAlignment="Center">
          <Button DockPanel.Dock="Left" Name="OpenSource" Width="46" Height="34" Padding="0" ToolTipService.ShowOnDisabled="True" Style="{StaticResource Primary}"/>
          <ComboBox DockPanel.Dock="Left" Name="SourceChoice" Padding="6,4" VerticalContentAlignment="Center" Width="142" Margin="0,0,10,0"/>
          <Button DockPanel.Dock="Right" Name="Fullscreen" Content="Fullscreen" ToolTip="Fullscreen video (F11). Press Escape or double-click the video to return." Margin="0"/>
          <ToggleButton DockPanel.Dock="Right" Name="ShowSettings" Style="{StaticResource TitleAction}" AutomationProperties.Name="Settings drawer" Margin="0,0,6,0">
            <StackPanel Orientation="Horizontal"><TextBlock Text="Settings" VerticalAlignment="Center"/>
              <Path Stroke="#9CBAB6" StrokeThickness="1.5" Data="M0,0 L4,4 L8,0" VerticalAlignment="Center" Margin="7,0,0,0" RenderTransformOrigin=".5,.5">
                <Path.Style><Style TargetType="Path"><Style.Triggers>
                  <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="False"><Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></DataTrigger>
                </Style.Triggers></Style></Path.Style>
              </Path>
            </StackPanel>
          </ToggleButton>
        </DockPanel>
        <Border Name="SettingsDrawer" Grid.Row="2" Height="0" ClipToBounds="True">
        <DockPanel Name="SettingsBody" VerticalAlignment="Top">
        <Thumb Name="SettingsResize" Style="{StaticResource DrawerGrip}" DockPanel.Dock="Top" Height="12" Cursor="SizeNS"
               AutomationProperties.Name="Resize settings drawer" ToolTip="Drag or use Up and Down to resize. Enter collapses the drawer."/>
        <Border Background="#172127" CornerRadius="8" BorderBrush="#2C3A41" BorderThickness="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Name="Pages" Margin="14,10">
        <StackPanel Name="PlayPage">
          <Border Style="{StaticResource GroupRail}">
            <WrapPanel KeyboardNavigation.DirectionalNavigation="Cycle">
              <Button Name="ConsoleGroup" Style="{StaticResource GroupTab}" Content="Console"/>
              <Button Name="DisplayGroup" Style="{StaticResource GroupTab}" Content="Graphics &amp; display"/>
              <Button Name="StreamGroup" Style="{StaticResource GroupTab}" Content="Stream quality"/>
              <Button Name="InterfaceGroup" Style="{StaticResource GroupTab}" Content="Interface"/>
              <Button Name="DiscordGroup" Style="{StaticResource GroupTab}" Content="Discord"/>
            </WrapPanel>
          </Border>
          <Grid Name="ConsoleSettings">
            <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0"><TextBlock Text="Paired console" Margin="0,0,0,5"/><ComboBox Name="ConsolePicker"/></StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Console address" Margin="0,0,0,5"/><TextBox Name="ConsoleAddress" ToolTip="Local IP address or DNS name of your PS5"/></StackPanel>
            <Button Grid.Column="2" Name="AddConsole" Content="Add console" VerticalAlignment="Bottom"/>
            <WrapPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0"><TextBlock Text="When I disconnect" VerticalAlignment="Center" Margin="0,0,9,0"/><ComboBox Name="StopBehavior" Width="182" ToolTip="Applies when stopping a Direct session or closing P5Cast. Remembered separately for each paired console."/><Button Name="WakeConsole" Content="Wake PS5" Margin="12,0,0,0" ToolTip="Wake the paired PS5 from rest mode without starting a stream."/></WrapPanel>
          </Grid>
          <StackPanel Name="StreamSettings" Visibility="Collapsed">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,12,0"><Label Content="PS5 stream resolution" Target="{Binding ElementName=DirectStreamSize}" Foreground="#DFEBEA" Padding="0,0,0,5"/><ComboBox Name="DirectStreamSize" AutomationProperties.Name="PS5 stream resolution" ToolTip="Resolution requested from the console on your next Direct connection."/></StackPanel>
              <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Requested video bitrate" Margin="0,0,0,5"/><ComboBox Name="DirectBitrate" ToolTip="Requested at connection time. The console adjusts the actual bitrate."/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="Frame rate" Margin="0,0,0,5"/><ComboBox Name="DirectFps"/></StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource Detail}" Margin="0,6,0,0" Text="Changes apply on your next connection. The PS5 sets the Opus audio bitrate."/>
          </StackPanel>
          <StackPanel Name="DisplaySettings" Visibility="Collapsed">
            <WrapPanel>
              <StackPanel Width="165" Margin="0,0,12,6"><Label Content="Graphics API" Target="{Binding ElementName=VideoRenderer}" Foreground="#DFEBEA" Padding="0,0,0,5"/><ComboBox Name="VideoRenderer" AutomationProperties.Name="Graphics API" ToolTipService.ShowOnDisabled="True" ToolTip="Choose the graphics API between playback sessions."/></StackPanel>
              <StackPanel Width="230" Margin="0,0,12,6"><TextBlock Text="Playback display" Margin="0,0,0,5"/>
                <ComboBox Name="PlaybackDisplay" ToolTip="{Binding SelectedItem, RelativeSource={RelativeSource Self}}">
                  <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <StackPanel Width="144" Margin="0,0,12,6"><TextBlock Text="Upscaling limit" Margin="0,0,0,5"/><ComboBox Name="RenderResolution" ToolTip="Maximum resolution an upscaler can produce. A lower limit preserves the source resolution."/></StackPanel>
              <StackPanel Width="124" Margin="0,0,0,6"><TextBlock Text="Color output" Margin="0,0,0,5"/><ComboBox Name="HdrOutput"/></StackPanel>
            </WrapPanel>
            <TextBlock Name="RendererHint" Style="{StaticResource Detail}" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel Name="InterfaceSettings" Visibility="Collapsed">
            <Label Content="Interface scale" Target="{Binding ElementName=InterfaceScale}" Foreground="#E8F0F1" Padding="0,0,0,5"/>
            <ComboBox Name="InterfaceScale" HorizontalAlignment="Left" Width="182" AutomationProperties.Name="Interface scale" ToolTip="Auto adapts to the monitor. A percentage adjusts the interface relative to Windows display scaling."/>
            <TextBlock Name="ScaleStatus" Style="{StaticResource Detail}" Margin="0,6,0,0"/>
          </StackPanel>
          <StackPanel Name="DiscordSettings" Visibility="Collapsed">
            <WrapPanel>
              <CheckBox Name="SharePresence" Content="Show P5Cast activity on Discord" Foreground="#E8F0F1" Margin="0,0,18,7"/>
              <CheckBox Name="ShareProject" Content="Include private GitHub link" Foreground="#E8F0F1" Margin="0,0,0,7"/>
            </WrapPanel>
            <WrapPanel>
              <CheckBox Name="ShareGame" Content="Show game title" Foreground="#E8F0F1" VerticalAlignment="Center" Margin="0,0,15,0"/>
              <TextBlock Text="Title override" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBox Name="GameTitle" Width="166" MaxLength="100" ToolTip="Optional title for this session. Direct can read the title if the PS5 supplies it."/>
            </WrapPanel>
            <TextBlock Name="DiscordState" Foreground="#B3C1C4" Margin="0,5,0,2"/>
            <TextBlock Foreground="#B3C1C4" Text="To broadcast, join a Discord voice channel, choose Share Your Screen → Applications → P5Cast, and enable sound."/>
          </StackPanel>
        </StackPanel>
        <StackPanel Name="StopPanel" Visibility="Collapsed">
          <TextBlock Name="StopTitle" Text="Stop playing?" Style="{StaticResource Heading}" Margin="0,0,0,7"/>
          <CheckBox Name="RestOnStop" Content="Put PS5 into rest mode" Foreground="#E8F0F1" Margin="0,0,0,6"/>
          <CheckBox Name="RememberStop" Content="Remember my choice for this console" Foreground="#E8F0F1" Margin="0,0,0,9"/>
          <StackPanel Orientation="Horizontal"><Button Name="ConfirmStop" Content="Stop session" Style="{StaticResource Primary}"/><Button Name="CancelStop" Content="Keep playing"/></StackPanel>
        </StackPanel>
        <StackPanel Name="PairPanel" Visibility="Collapsed">
          <TextBlock Text="Add console" Style="{StaticResource Heading}" Margin="0,0,0,2"/>
          <TextBlock Text="On your PS5, open Settings → System → Remote Play → Link Device." Foreground="#B3C1C4" Margin="0,0,0,7"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0"><TextBlock Text="Console address"/><TextBox Name="PairAddress"/></StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="PSN Account ID (Base64)"/><TextBox Name="PsnAccount"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="Link Device code"/><TextBox Name="PairCode" MaxLength="9"/></StackPanel>
          </Grid>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Name="PairConsole" Content="Pair console" Style="{StaticResource Primary}"/><Button Name="CancelPair" Content="Cancel"/></StackPanel>
        </StackPanel>
        <StackPanel Name="HostPage" Visibility="Collapsed">
          <Border Style="{StaticResource GroupRail}"><WrapPanel KeyboardNavigation.DirectionalNavigation="Cycle"><Button Name="SharingGroup" Style="{StaticResource GroupTab}" Content="Sharing"/><Button Name="DevicesGroup" Style="{StaticResource GroupTab}" Content="Paired devices"/></WrapPanel></Border>
          <StackPanel Name="SharingSettings">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,12,0"><TextBlock Text="Listen on this network address" Margin="0,0,0,5"/><ComboBox Name="BindIP"/></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="Display to share" Margin="0,0,0,5"/><ComboBox Name="HostDisplay"/></StackPanel>
            </Grid>
            <WrapPanel Margin="0,8,0,0"><Button Name="StartHost" Content="Start sharing" Style="{StaticResource Primary}"/><Button Name="StopHost" Content="Stop sharing"/><Button Name="HostStatus" Content="Check status"/></WrapPanel>
            <TextBlock Name="HostState" Style="{StaticResource Detail}" Margin="0,4,0,0" Text="Sharing continues until you select Stop sharing."/>
          </StackPanel>
          <StackPanel Name="DevicesSettings" Visibility="Collapsed">
            <TextBlock Text="Pair a client using its four-digit PIN" Margin="0,0,0,4"/>
            <WrapPanel><TextBox Name="Pin" MaxLength="4" Width="86" Margin="0,0,8,0"/><Button Name="ApprovePin" Content="Approve PIN"/><Button Name="Controllers" Content="Controller driver setup &#8599;"/></WrapPanel>
            <WrapPanel Margin="0,8,0,0"><Button Name="LoadPeers" Content="Load devices"/><ComboBox Name="Peers" DisplayMemberPath="Name" SelectedValuePath="Id" Width="166" Margin="0,0,8,0"/><Button Name="RemovePeer" Content="Revoke access"/></WrapPanel>
          </StackPanel>
        </StackPanel>
        <StackPanel Name="ClientPage" Visibility="Collapsed">
          <Border Style="{StaticResource GroupRail}"><WrapPanel KeyboardNavigation.DirectionalNavigation="Cycle"><Button Name="NetworkGroup" Style="{StaticResource GroupTab}" Content="Connection"/><Button Name="QualityGroup" Style="{StaticResource GroupTab}" Content="Stream quality"/></WrapPanel></Border>
          <StackPanel Name="NetworkSettings">
            <TextBlock Text="Host PC address" Margin="0,0,0,4"/>
            <WrapPanel><TextBox Name="HostAddress" Width="215" Margin="0,0,8,0" ToolTip="Use the host's LAN or private VPN address."/><Button Name="ClientPair" Content="Pair with host"/><Button Name="ClientPlay" Style="{StaticResource Primary}" Content="Start stream"/></WrapPanel>
            <Button Name="DirectClient" Content="Play directly from my PS5" HorizontalAlignment="Left" Margin="0,8,0,0"/>
          </StackPanel>
          <StackPanel Name="QualitySettings" Visibility="Collapsed">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,12,0"><TextBlock Text="Video preset" Margin="0,0,0,4"/><ComboBox Name="Quality"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="Audio output" Margin="0,0,0,4"/><ComboBox Name="NetworkAudio"/></StackPanel>
              <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Video bitrate" Margin="0,0,0,4"/><ComboBox Name="NetworkBitrate"/></StackPanel>
            </Grid>
            <CheckBox Name="ClientHdr" Foreground="#E8F0F1" Content="Request HDR" Margin="0,8,0,0"/>
          </StackPanel>
        </StackPanel>
      </Grid>
        </ScrollViewer></Border>
        </DockPanel></Border>
      </Grid>
      <Border Name="SidebarDrawer" Grid.Column="1" Width="0" ClipToBounds="True">
        <Grid Name="SidebarBody" HorizontalAlignment="Left">
        <Border Name="MeterHost" Background="#172127" CornerRadius="8" BorderBrush="#2C3A41" BorderThickness="1" Margin="12,0,0,0"/>
        <Thumb Name="SidebarResize" Style="{StaticResource DrawerGrip}" Tag="Vertical" Width="12" HorizontalAlignment="Left" Cursor="SizeWE"
               AutomationProperties.Name="Resize performance sidebar" ToolTip="Drag or use Left and Right to resize. Enter collapses the sidebar."/>
        </Grid>
      </Border>
    </Grid>
    <Border Name="StatusFooter" Grid.Row="2" Background="#121D22" BorderBrush="#293940" BorderThickness="0,1,0,0"
            ClipToBounds="True" Visibility="{Binding Visibility, ElementName=HeaderBar}">
      <StackPanel>
        <Border Name="StatusHistorySheet" Visibility="Collapsed" Padding="22,8,16,8" BorderBrush="#304247" BorderThickness="0,0,0,1">
          <Grid Height="174"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Margin="2,0,0,4">
              <Button Name="CloseStatusHistory" DockPanel.Dock="Right" Width="34" MinWidth="34" Height="30" Style="{StaticResource TitleAction}"
                      AutomationProperties.Name="Close status history" ToolTip="Close status history (Esc)">
                <Path Data="M2,2 L12,12 M12,2 L2,12" Stroke="#B7CACC" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              </Button>
              <TextBlock Text="Status history" FontSize="15" FontWeight="SemiBold" Foreground="#ECF5F3" VerticalAlignment="Center"/>
            </DockPanel>
            <ListBox Grid.Row="1" Name="StatusHistoryList" AutomationProperties.Name="Status history" Background="Transparent"
                     Foreground="#CFDCDE" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListBox.Template><ControlTemplate TargetType="ListBox">
                <ScrollViewer Name="HistoryScroll" Style="{StaticResource {x:Type ScrollViewer}}"
                              CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsPresenter/>
                </ScrollViewer>
              </ControlTemplate></ListBox.Template>
              <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="2,5"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                  <Border Name="Row" Padding="{TemplateBinding Padding}" CornerRadius="4"><ContentPresenter/></Border>
                  <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="#25373D"/>
                  </Trigger></ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
              </Style></ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate><DataTemplate>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding ClockTime}" FontSize="12" Foreground="#9FB1B6" MinWidth="76" Margin="0,1,12,0" ToolTip="{Binding Timestamp}"/>
                  <TextBlock Grid.Column="1" Text="Error" Margin="0,0,8,0" Foreground="#FFBAA8" FontWeight="SemiBold" FontSize="13">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers><DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                    </Style></TextBlock.Style>
                  </TextBlock>
                  <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="13" TextWrapping="Wrap"/>
                </Grid>
              </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
        <Button Name="StatusHistoryButton" Cursor="Hand" HorizontalContentAlignment="Stretch" Padding="24,7,20,7"
                AutomationProperties.Name="Show status history" ToolTip="Show status history">
          <Button.Template><ControlTemplate TargetType="Button">
            <Border Name="StatusFace" Background="Transparent" BorderThickness="1" BorderBrush="Transparent"
                    Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="StatusFace" Property="Background" Value="#1A292F"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="StatusFace" Property="BorderBrush" Value="#83B5AD"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate></Button.Template>
          <DockPanel LastChildFill="True">
            <Ellipse Name="Indicator" DockPanel.Dock="Left" Width="7" Height="7" Fill="#91DECA" Margin="0,0,10,0"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="History" FontSize="12" Foreground="#AAC3C1" VerticalAlignment="Center"/>
              <Path Name="HistoryChevron" Data="M0,4 L4,0 L8,4" Stroke="#AAC3C1" StrokeThickness="1.5"
                    Margin="7,0,0,0" VerticalAlignment="Center" RenderTransformOrigin=".5,.5"><Path.RenderTransform><RotateTransform/></Path.RenderTransform></Path>
            </StackPanel>
            <Grid Height="23" ClipToBounds="True">
              <TextBlock Name="PreviousStatus" Opacity="0" VerticalAlignment="Center" Foreground="#CAD8D9" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"><TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform></TextBlock>
              <TextBlock Name="Status" Text="Ready" VerticalAlignment="Center" Foreground="#CAD8D9" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"><TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform></TextBlock>
            </Grid>
          </DockPanel>
        </Button>
      </StackPanel>
    </Border>
    </Grid>
  </Grid>
</Window>
