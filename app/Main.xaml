<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="P5Cast" Width="1320" Height="860" MinWidth="880" MinHeight="590"
        Background="{DynamicResource Theme.Background}" Foreground="{DynamicResource Theme.Text}" FontFamily="Segoe UI"
        FontSize="14" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="WipeSlider" TargetType="Slider">
      <Setter Property="Height" Value="22"/><Setter Property="Margin" Value="2,2"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
        <Grid Background="Transparent">
          <Border Height="3" Margin="5,0" CornerRadius="1.5" Background="{DynamicResource Theme.StrongBorder}"/>
          <Track x:Name="PART_Track" Orientation="Horizontal">
            <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False" Opacity="0"/></Track.DecreaseRepeatButton>
            <Track.Thumb><Thumb Width="12" Height="16" Cursor="SizeWE"><Thumb.Template><ControlTemplate TargetType="Thumb">
              <Border CornerRadius="5" Background="{DynamicResource Theme.Accent}" BorderThickness="1" BorderBrush="{DynamicResource Theme.Accent}"/>
            </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False" Opacity="0"/></Track.IncreaseRepeatButton>
          </Track>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="TitleAction" TargetType="ButtonBase">
      <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="MinWidth" Value="38"/><Setter Property="Padding" Value="9,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ButtonBase">
        <Grid Background="Transparent">
          <Border Name="ButtonFace" Height="34" VerticalAlignment="Center" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonFace" Property="Background" Value="{DynamicResource Theme.Border}"/></Trigger>
          <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="Tag" Value="Close"/></MultiTrigger.Conditions><Setter TargetName="ButtonFace" Property="Background" Value="{DynamicResource Theme.Danger}"/></MultiTrigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonFace" Property="Opacity" Value="0.7"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonFace" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="Detail" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="{DynamicResource Theme.Muted}"/><Setter Property="FontSize" Value="14"/><Setter Property="LineHeight" Value="21"/></Style>
    <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="21"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,6"/><Setter Property="MinHeight" Value="32"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/><Setter Property="Background" Value="{DynamicResource Theme.Control}"/><Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid>
          <Border x:Name="Surface" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
          <Border Name="Wash" CornerRadius="7" Margin="1" Background="{DynamicResource Theme.Text}" Opacity="0"/>
          <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Wash" Property="Opacity" Value="0.08"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Wash" Property="Background" Value="Black"/><Setter TargetName="Wash" Property="Opacity" Value="0.14"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.48"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource Theme.AccentText}"/><Setter Property="Background" Value="{DynamicResource Theme.Accent}"/><Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
    </Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Theme.Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
    <Style x:Key="GroupRail" TargetType="Border">
      <Setter Property="Width" Value="158"/><Setter Property="Background" Value="{DynamicResource Theme.Panel}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/><Setter Property="BorderThickness" Value="0,0,1,0"/>
      <Setter Property="Padding" Value="8,9"/>
    </Style>
    <Style x:Key="GroupTab" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Theme.Muted}"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="MinHeight" Value="28"/><Setter Property="Margin" Value="0,1"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border Name="Face" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5">
          <Grid>
            <Border Name="Marker" Width="2" Margin="0,5" HorizontalAlignment="Left" Background="Transparent" CornerRadius="1"/>
            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,2,5,2" RecognizesAccessKey="True"/>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="{DynamicResource Theme.Hover}"/></Trigger>
          <Trigger Property="AutomationProperties.ItemStatus" Value="Selected">
            <Setter TargetName="Face" Property="Background" Value="{DynamicResource Theme.Selected}"/><Setter TargetName="Marker" Property="Background" Value="{DynamicResource Theme.Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}"/><Setter Property="FontWeight" Value="SemiBold"/>
          </Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingsCaption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Theme.Muted}"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="SettingsHeading" TargetType="TextBlock">
      <Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,9"/>
    </Style>
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="14"/><Setter Property="Background" Value="Transparent"/><Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
          <Track Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
            <Track.DecreaseRepeatButton><RepeatButton Name="Before" Style="{StaticResource ScrollPage}" Command="{x:Static ScrollBar.PageUpCommand}"/></Track.DecreaseRepeatButton>
            <Track.Thumb>
              <Thumb Name="Grip" Background="{DynamicResource Theme.StrongBorder}" Focusable="False">
                <Thumb.Template><ControlTemplate TargetType="Thumb">
                  <Grid Background="Transparent"><Border Name="Pill" CornerRadius="4" Margin="4,2" Background="{TemplateBinding Background}"/></Grid>
                  <ControlTemplate.Triggers>
                    <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="Horizontal"><Setter TargetName="Pill" Property="Margin" Value="2,4"/></DataTrigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="Background" Value="{DynamicResource Theme.StrongBorder}"/></Trigger>
                    <Trigger Property="IsDragging" Value="True"><Setter TargetName="Pill" Property="Background" Value="{DynamicResource Theme.Accent}"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate></Thumb.Template>
              </Thumb>
            </Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton Name="After" Style="{StaticResource ScrollPage}" Command="{x:Static ScrollBar.PageDownCommand}"/></Track.IncreaseRepeatButton>
          </Track>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="Orientation" Value="Horizontal">
            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
            <Setter TargetName="Before" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/><Setter TargetName="After" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Height" Value="14"/><Setter Property="Width" Value="Auto"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="ScrollViewer">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollViewer">
        <Grid Background="{TemplateBinding Background}">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <ScrollContentPresenter Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}" CanContentScroll="{TemplateBinding CanContentScroll}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
          <ScrollBar Name="PART_VerticalScrollBar" Style="{StaticResource {x:Type ScrollBar}}" Grid.Column="1" Orientation="Vertical" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
            Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"/>
          <ScrollBar Name="PART_HorizontalScrollBar" Style="{StaticResource {x:Type ScrollBar}}" Grid.Row="1" Orientation="Horizontal" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
            Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}" Value="{Binding HorizontalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"/>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/><Setter Property="Background" Value="{DynamicResource Theme.Panel}"/><Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,5"/><Setter Property="MinHeight" Value="32"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="CaretBrush" Value="{DynamicResource Theme.Accent}"/><Setter Property="SelectionBrush" Value="{DynamicResource Theme.StrongBorder}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
          <ScrollViewer Name="PART_ContentHost" Focusable="False" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Theme.StrongBorder}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.48"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <StackPanel Orientation="Horizontal" Background="Transparent">
          <Border Name="Box" Width="17" Height="17" CornerRadius="5" Background="{DynamicResource Theme.Panel}" BorderBrush="{DynamicResource Theme.StrongBorder}" BorderThickness="1" VerticalAlignment="Center">
            <Path Name="Tick" Visibility="Hidden" Width="10" Height="8" Stretch="Uniform" Stroke="{DynamicResource Theme.AccentText}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M1,4 L4,7 L10,1"/>
          </Border>
          <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </StackPanel>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Theme.StrongBorder}"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Tick" Property="Visibility" Value="Visible"/><Setter TargetName="Box" Property="Background" Value="{DynamicResource Theme.Accent}"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Theme.Text}"/><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.48"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/><Setter Property="Padding" Value="9,6"/><Setter Property="Margin" Value="0,1"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
        <Border Name="Item" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="5"><ContentPresenter/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource Theme.Selected}"/></Trigger>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource Theme.Hover}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.46"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/><Setter Property="MinHeight" Value="32"/><Setter Property="MaxDropDownHeight" Value="320"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <Border Name="Field" Background="{DynamicResource Theme.Control}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="7"/>
          <ToggleButton Focusable="False" ClickMode="Press" Cursor="Hand" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" CornerRadius="7"/></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <Grid IsHitTestVisible="False" Margin="10,3">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/></Grid.ColumnDefinitions>
            <ContentPresenter VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
            <Path Grid.Column="1" Data="M 1,2 L 5,6 L 9,2" Stroke="{DynamicResource Theme.Muted}" StrokeThickness="1.5" VerticalAlignment="Center"/>
          </Grid>
          <Popup Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" VerticalOffset="3">
            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}" CornerRadius="8" BorderBrush="{DynamicResource Theme.StrongBorder}" BorderThickness="1" Background="{DynamicResource Theme.Control}" Padding="4">
              <ScrollViewer Style="{StaticResource {x:Type ScrollViewer}}" CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Theme.StrongBorder}"/></Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/></Trigger>
          <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Field" Property="Background" Value="{DynamicResource Theme.Surface}"/><Setter Property="Opacity" Value="0.55"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid Name="WindowFrame">
    <Grid Name="InterfaceRoot">
    <Grid.RowDefinitions><RowDefinition Name="HeaderRow" Height="52"/><RowDefinition Height="*"/><RowDefinition Name="StatusRow" Height="Auto"/></Grid.RowDefinitions>
    <Border Name="HeaderBar" Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,0,0,1">
      <Border.Style><Style TargetType="Border">
        <Setter Property="Padding" Value="16,6,6,6"/>
        <Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
          <Setter Property="Padding" Value="16,0,0,0"/>
        </DataTrigger></Style.Triggers>
      </Style></Border.Style>
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
          <Image Width="26" Height="26" Stretch="Uniform" Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}"/>
          <TextBlock Text="P5Cast" FontWeight="SemiBold" FontSize="19" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Name="PlayNav" Content="Play" Style="{StaticResource TitleAction}" MinWidth="58"/>
          <Button Name="HostNav" Content="Host" Style="{StaticResource TitleAction}" MinWidth="58"/>
          <Button Name="ClientNav" Content="Client" Style="{StaticResource TitleAction}" MinWidth="58"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <ToggleButton Name="ShowStats" Style="{StaticResource TitleAction}" AutomationProperties.Name="Performance sidebar">
            <Canvas Width="22" Height="22" IsHitTestVisible="False">
              <Line Name="MenuTop" X1="2" X2="20" Y1="11" Y2="11" Stroke="{DynamicResource Theme.Accent}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                <Line.RenderTransform><TransformGroup><RotateTransform CenterX="11" CenterY="11"/><TranslateTransform Y="-3"/></TransformGroup></Line.RenderTransform>
              </Line>
              <Line Name="MenuBottom" X1="2" X2="20" Y1="11" Y2="11" Stroke="{DynamicResource Theme.Accent}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                <Line.RenderTransform><TransformGroup><RotateTransform CenterX="11" CenterY="11"/><TranslateTransform Y="3"/></TransformGroup></Line.RenderTransform>
              </Line>
            </Canvas>
          </ToggleButton>
          <Border Background="{DynamicResource Theme.Border}" Width="1" Height="18" Margin="6,0"/>
          <Button Name="MinimizeWindow" Style="{StaticResource TitleAction}" ToolTip="Minimize" AutomationProperties.Name="Minimize"><Path Stroke="{DynamicResource Theme.Muted}" StrokeThickness="1.2" Data="M0,5 H10"/></Button>
          <Button Name="MaximizeWindow" Style="{StaticResource TitleAction}" ToolTip="Maximize" AutomationProperties.Name="Maximize"><Path Name="MaximizeGlyph" Stroke="{DynamicResource Theme.Muted}" StrokeThickness="1.2" Data="M0,0 H10 V10 H0 Z"/></Button>
          <Button Name="CloseWindow" Tag="Close" Style="{StaticResource TitleAction}" ToolTip="Close" AutomationProperties.Name="Close P5Cast"><Path Stroke="{DynamicResource Theme.Text}" StrokeThickness="1.25" Data="M0,0 L10,10 M10,0 L0,10"/></Button>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Name="Workspace" Grid.Row="1" Margin="16,14,16,12">
      <Grid.Resources>
        <Style x:Key="DrawerGrip" TargetType="Thumb">
          <Setter Property="Focusable" Value="True"/><Setter Property="IsTabStop" Value="True"/>
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
            <Grid Background="Transparent">
              <Border Name="Grip" Width="36" Height="3" CornerRadius="2" Background="{DynamicResource Theme.StrongBorder}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Tag" Value="Vertical"><Setter TargetName="Grip" Property="Width" Value="3"/><Setter TargetName="Grip" Property="Height" Value="36"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource Theme.Accent}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource Theme.Accent}"/></Trigger>
              <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource Theme.Accent}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate></Setter.Value></Setter>
        </Style>
      </Grid.Resources>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Name="MeterColumn" Width="Auto"/></Grid.ColumnDefinitions>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Name="TransportRow" Height="52"/><RowDefinition Name="SettingsRow" Height="Auto"/></Grid.RowDefinitions>
        <Border Name="VideoHost" Background="Black" ClipToBounds="True"/>
        <Grid Name="OperationOverlay" Visibility="Collapsed" ClipToBounds="True" AutomationProperties.LabeledBy="{Binding ElementName=OperationTitle}">
          <Border Name="OperationCard" HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="470" Margin="10,10,10,0" Padding="12,9" CornerRadius="10"
                  Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Grid Name="OperationSpinner" Width="32" Height="32" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False">
                <Ellipse Stroke="{DynamicResource Theme.Border}" StrokeThickness="2.5"/>
                <Path Data="M 16,1.25 A 14.75,14.75 0 0 1 30.75,16" Stroke="{DynamicResource Theme.Accent}" StrokeThickness="2.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                  <Path.RenderTransform><RotateTransform x:Name="OperationRotation"/></Path.RenderTransform>
                </Path>
              </Grid>
              <StackPanel Grid.Column="1">
                <TextBlock Name="OperationTitle" TextWrapping="Wrap" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Text}"
                           Focusable="True" KeyboardNavigation.IsTabStop="False"/>
                <TextBlock Name="OperationDetail" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{DynamicResource Theme.Muted}" AutomationProperties.LiveSetting="Polite"/>
              </StackPanel>
              <Button Name="CancelOperation" Grid.Column="2" Content="Cancel" VerticalAlignment="Center" MinWidth="64" Margin="12,0,0,0"/>
            </Grid>
          </Border>
        </Grid>
        <DockPanel Name="TransportBar" Grid.Row="1" LastChildFill="False" VerticalAlignment="Center">
          <Button DockPanel.Dock="Left" Name="OpenSource" Width="46" Height="34" Padding="0" ToolTipService.ShowOnDisabled="True" Style="{StaticResource Primary}"/>
          <ComboBox DockPanel.Dock="Left" Name="SourceChoice" Padding="6,4" VerticalContentAlignment="Center" Width="142" Margin="0,0,10,0"/>
          <Grid DockPanel.Dock="Left" Margin="0,0,6,0">
            <Button Name="OpenVolume" Style="{StaticResource TitleAction}" Padding="6,0" MinWidth="32"
                    AutomationProperties.Name="Stream volume" ToolTip="Stream volume">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="19" Height="18">
                  <Path Data="M1,6 L5,6 L10,2 L10,16 L5,12 L1,12 Z" StrokeThickness="1.4"
                        Stroke="{Binding Foreground, ElementName=OpenVolume}" StrokeLineJoin="Round"/>
                  <Path Name="VolumeWaves" Data="M13,6 Q16,9 13,12 M15,3 Q21,9 15,15" StrokeThickness="1.4"
                        Stroke="{Binding Foreground, ElementName=OpenVolume}" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                  <Path Name="VolumeCross" Data="M13,6 L18,12 M18,6 L13,12" StrokeThickness="1.4" Visibility="Collapsed"
                        Stroke="{Binding Foreground, ElementName=OpenVolume}" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Grid>
                <TextBlock Name="VolumeBadge" VerticalAlignment="Center" Margin="5,0,0,0" TextWrapping="NoWrap"/>
              </StackPanel>
            </Button>
            <Popup Name="VolumePopup" PlacementTarget="{Binding ElementName=OpenVolume}" Placement="Top" VerticalOffset="-4"
                   AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
              <Border CornerRadius="8" Padding="14,10" Width="228" Background="{DynamicResource Theme.Surface}" BorderThickness="1" BorderBrush="{DynamicResource Theme.Border}">
                <StackPanel KeyboardNavigation.TabNavigation="Cycle">
                  <DockPanel Margin="0,0,0,4">
                    <TextBlock DockPanel.Dock="Right" Name="VolumeReadout" Foreground="{DynamicResource Theme.Accent}" VerticalAlignment="Center"/>
                    <Label Content="Stream volume" Target="{Binding ElementName=StreamVolumeSlider}" Padding="0" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Text}"/>
                  </DockPanel>
                  <Slider Name="StreamVolumeSlider" Style="{StaticResource WipeSlider}" Minimum="0" Maximum="100" TickFrequency="1"
                          IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" SmallChange="1" LargeChange="10" AutomationProperties.Name="Stream volume percent"/>
                  <CheckBox Name="MuteStream" Content="Mute stream" Margin="0,5,0,0" Foreground="{DynamicResource Theme.Text}"/>
                </StackPanel>
              </Border>
            </Popup>
          </Grid>
          <Button DockPanel.Dock="Right" Name="Fullscreen" Content="Fullscreen" ToolTip="Fullscreen video (F11). Press Escape or double-click the video to return." Margin="0"/>
          <ToggleButton DockPanel.Dock="Right" Name="ShowSettings" Style="{StaticResource TitleAction}" AutomationProperties.Name="Settings drawer" Margin="0,0,6,0">
            <StackPanel Orientation="Horizontal"><TextBlock Name="SettingsActionLabel" Text="Settings" VerticalAlignment="Center"/>
              <Path Name="SettingsActionGlyph" Width="15" Height="15" Stretch="Uniform" Visibility="Collapsed" Stroke="{DynamicResource Theme.Muted}" StrokeThickness="1.5"
                    Data="M1,3 H5 M9,3 H15 M1,9 H8 M12,9 H15 M5,1 V5 H9 V1 Z M8,7 V11 H12 V7 Z"/>
              <Path Stroke="{DynamicResource Theme.Muted}" StrokeThickness="1.5" Data="M0,0 L4,4 L8,0" VerticalAlignment="Center" Margin="7,0,0,0" RenderTransformOrigin=".5,.5">
                <Path.Style><Style TargetType="Path"><Style.Triggers>
                  <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="False"><Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></DataTrigger>
                </Style.Triggers></Style></Path.Style>
              </Path>
            </StackPanel>
          </ToggleButton>
          <Button DockPanel.Dock="Right" Name="OpenSetup" AutomationProperties.Name="Guided setup" ToolTip="Open guided setup"
                  Foreground="{DynamicResource Theme.Accent}" Background="{DynamicResource Theme.Selected}" BorderBrush="{DynamicResource Theme.StrongBorder}" Margin="0,0,5,0" Padding="10,4">
            <StackPanel Orientation="Horizontal">
              <Path Width="15" Height="15" Stretch="Uniform" Stroke="{DynamicResource Theme.Accent}" StrokeThickness="1.45" StrokeLineJoin="Round"
                    Data="M8,1 A7,7 0 1 1 7.99,1 M10.8,5.2 L9,9 L5.2,10.8 L7,7 Z"/>
              <TextBlock Text="Setup" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>
          </Button>
        </DockPanel>
        <Border Name="SettingsDrawer" Grid.Row="2" Height="0" ClipToBounds="True">
        <DockPanel Name="SettingsBody" VerticalAlignment="Top">
        <Thumb Name="SettingsResize" Style="{StaticResource DrawerGrip}" DockPanel.Dock="Top" Height="12" Cursor="SizeNS"
               AutomationProperties.Name="Resize settings drawer" ToolTip="Drag or use Up and Down to resize. Enter collapses the drawer."/>
        <Border Background="{DynamicResource Theme.Surface}" CornerRadius="8" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1">
          <DockPanel Name="SettingsWorkbench">
            <Grid Name="CompactSettingsSections" DockPanel.Dock="Top" Background="{DynamicResource Theme.Panel}" Visibility="Collapsed" IsEnabled="{Binding IsEnabled, ElementName=Pages}">
              <DockPanel Visibility="{Binding Visibility, ElementName=PlayPage}" Margin="12,8">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource SettingsCaption}" Text="Play settings" Margin="0,0,12,0"/>
                <ComboBox Name="PlaySectionPicker" MaxWidth="290" HorizontalAlignment="Left" MinWidth="172" AutomationProperties.Name="Play settings section"/>
              </DockPanel>
              <DockPanel Visibility="{Binding Visibility, ElementName=HostPage}" Margin="12,8">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource SettingsCaption}" Text="Host settings" Margin="0,0,12,0"/>
                <ComboBox Name="HostSectionPicker" MaxWidth="290" HorizontalAlignment="Left" MinWidth="172" AutomationProperties.Name="Host settings section"/>
              </DockPanel>
              <DockPanel Visibility="{Binding Visibility, ElementName=ClientPage}" Margin="12,8">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource SettingsCaption}" Text="Client settings" Margin="0,0,12,0"/>
                <ComboBox Name="ClientSectionPicker" MaxWidth="290" HorizontalAlignment="Left" MinWidth="172" AutomationProperties.Name="Client settings section"/>
              </DockPanel>
            </Grid>
            <Grid Name="SettingsSections" DockPanel.Dock="Left" IsEnabled="{Binding IsEnabled, ElementName=Pages}">
              <Border Style="{StaticResource GroupRail}" Visibility="{Binding Visibility, ElementName=PlayPage}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel KeyboardNavigation.DirectionalNavigation="Cycle">
                    <TextBlock Style="{StaticResource SettingsCaption}" Text="Play settings" Margin="10,0,0,6"/>
                    <Button Name="ConsoleGroup" Style="{StaticResource GroupTab}" Content="Console"/>
                    <Button Name="StreamGroup" Style="{StaticResource GroupTab}" Content="Stream quality"/>
                    <Button Name="DisplayGroup" Style="{StaticResource GroupTab}" Content="Graphics &amp; display"/>
                    <Button Name="InterfaceGroup" Style="{StaticResource GroupTab}" Content="Interface"/>
                    <Button Name="DiscordGroup" Style="{StaticResource GroupTab}" Content="Discord"/>
                  </StackPanel>
                </ScrollViewer>
              </Border>
              <Border Style="{StaticResource GroupRail}" Visibility="{Binding Visibility, ElementName=HostPage}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel KeyboardNavigation.DirectionalNavigation="Cycle">
                    <TextBlock Style="{StaticResource SettingsCaption}" Text="Host settings" Margin="10,0,0,6"/>
                    <Button Name="SharingGroup" Style="{StaticResource GroupTab}" Content="Sharing"/>
                    <Button Name="DevicesGroup" Style="{StaticResource GroupTab}" Content="Paired devices"/>
                  </StackPanel>
                </ScrollViewer>
              </Border>
              <Border Style="{StaticResource GroupRail}" Visibility="{Binding Visibility, ElementName=ClientPage}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel KeyboardNavigation.DirectionalNavigation="Cycle">
                    <TextBlock Style="{StaticResource SettingsCaption}" Text="Client settings" Margin="10,0,0,6"/>
                    <Button Name="NetworkGroup" Style="{StaticResource GroupTab}" Content="Connection"/>
                    <Button Name="QualityGroup" Style="{StaticResource GroupTab}" Content="Stream quality"/>
                  </StackPanel>
                </ScrollViewer>
              </Border>
            </Grid>
            <ScrollViewer Name="SettingsContentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <Grid Name="Pages" Margin="14,10">
              <StackPanel Name="PlayPage">
                <TextBlock Name="PlaySettingsHeading" Style="{StaticResource SettingsHeading}"/>
                <Grid Name="ConsoleSettings">
                  <StackPanel>
                    <UniformGrid Name="ConsoleFields" Columns="2">
                      <StackPanel Margin="0,0,10,6"><TextBlock Text="Paired console" Margin="0,0,0,5"/><ComboBox Name="ConsolePicker"/></StackPanel>
                      <StackPanel Margin="0,0,10,6"><TextBlock Text="Console address" Margin="0,0,0,5"/><TextBox Name="ConsoleAddress" ToolTip="Local IP address or DNS name of your PS5"/></StackPanel>
                    </UniformGrid>
                    <WrapPanel Margin="0,0,0,9"><Button Name="AddConsole" Content="Add console"/><Button Name="WakeConsole" Content="Wake PS5" ToolTip="Wake the paired PS5 from rest mode without starting a stream."/></WrapPanel>
                    <WrapPanel><TextBlock Text="When I disconnect" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox Name="StopBehavior" Width="182" ToolTip="Applies when stopping a Direct session or closing P5Cast. Remembered separately for each paired console."/></WrapPanel>
                    <CheckBox Name="DualSenseFeedback" Content="DualSense feedback" Margin="0,10,0,0" ToolTip="Enable game-controlled adaptive triggers and supported haptics on your next Direct to PS5 connection."/>
                  </StackPanel>
                </Grid>
                <StackPanel Name="StreamSettings" Visibility="Collapsed">
                  <UniformGrid Name="StreamFields" Columns="3">
                    <StackPanel Margin="0,0,10,6"><Label Content="PS5 stream resolution" Target="{Binding ElementName=DirectStreamSize}" Foreground="{DynamicResource Theme.Text}" Padding="0,0,0,5"/><ComboBox Name="DirectStreamSize" AutomationProperties.Name="PS5 stream resolution" ToolTip="Resolution requested from the console on your next Direct connection."/></StackPanel>
                    <StackPanel Margin="0,0,10,6"><TextBlock Text="Requested video bitrate" Margin="0,0,0,5"/><ComboBox Name="DirectBitrate" ToolTip="Requested at connection time. The console adjusts the actual bitrate."/></StackPanel>
                    <StackPanel Margin="0,0,10,6"><TextBlock Text="Frame rate" Margin="0,0,0,5"/><ComboBox Name="DirectFps"/></StackPanel>
                    <StackPanel Margin="0,0,10,6"><Label Content="SDR video codec" Target="{Binding ElementName=DirectSdrCodec}" Foreground="{DynamicResource Theme.Text}" Padding="0,0,0,5"/><ComboBox Name="DirectSdrCodec" ToolTip="Codec requested for SDR playback. Direct PS5 HDR10 always uses HEVC."/></StackPanel>
                  </UniformGrid>
                  <TextBlock Style="{StaticResource Detail}" Margin="0,6,0,0" Text="Changes apply on your next connection. The PS5 sets the Opus audio bitrate."/>
                </StackPanel>
                <StackPanel Name="DisplaySettings" Visibility="Collapsed">
                  <UniformGrid Name="DisplayFields" Columns="2">
                    <StackPanel Margin="0,0,10,6"><Label Content="Graphics API" Target="{Binding ElementName=VideoRenderer}" Foreground="{DynamicResource Theme.Text}" Padding="0,0,0,5"/><ComboBox Name="VideoRenderer" AutomationProperties.Name="Graphics API" ToolTipService.ShowOnDisabled="True" ToolTip="Choose the graphics API between playback sessions."/></StackPanel>
                    <StackPanel Margin="0,0,10,6"><TextBlock Text="Playback display" Margin="0,0,0,5"/>
                      <ComboBox Name="PlaybackDisplay" ToolTip="{Binding SelectedItem, RelativeSource={RelativeSource Self}}">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
                      </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,6"><TextBlock Text="Upscaling target" Margin="0,0,0,5"/><ComboBox Name="RenderResolution" ToolTip="Fit playback area follows the window. A fixed target processes video at that size before fitting it on screen. Smaller targets preserve the source resolution."/></StackPanel>
                    <StackPanel Margin="0,0,10,6"><TextBlock Text="Color output" Margin="0,0,0,5"/><ComboBox Name="HdrOutput"/></StackPanel>
                  </UniformGrid>
                  <TextBlock Name="RendererHint" Style="{StaticResource Detail}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Name="InterfaceSettings" Visibility="Collapsed">
                  <Label Content="Color theme" Target="{Binding ElementName=ColorTheme}" Foreground="{DynamicResource Theme.Text}" Padding="0,0,0,5"/>
                  <WrapPanel>
                    <ComboBox Name="ColorTheme" Width="182" Margin="0,0,8,4" AutomationProperties.Name="Color theme"/>
                    <Button Name="EditThemeJson" Content="Edit JSON" Margin="0,0,8,4" ToolTip="Open your custom theme in Notepad."/>
                    <Button Name="ReloadTheme" Content="Reload" Margin="0,0,0,4" ToolTip="Apply your saved custom colors."/>
                  </WrapPanel>
                  <TextBlock Name="ThemeStatus" Margin="0,0,0,10" Foreground="{DynamicResource Theme.Muted}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                  <Label Content="Interface scale" Target="{Binding ElementName=InterfaceScale}" Foreground="{DynamicResource Theme.Text}" Padding="0,0,0,5"/>
                  <ComboBox Name="InterfaceScale" HorizontalAlignment="Left" Width="182" AutomationProperties.Name="Interface scale" ToolTip="Auto adapts to the monitor. A percentage adjusts the interface relative to Windows display scaling."/>
                  <TextBlock Name="ScaleStatus" Style="{StaticResource Detail}" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Name="DiscordSettings" Visibility="Collapsed">
                  <WrapPanel>
                    <CheckBox Name="SharePresence" Content="Show P5Cast activity on Discord" Foreground="{DynamicResource Theme.Text}" Margin="0,0,18,7"/>
                    <CheckBox Name="ShareProject" Content="Include private GitHub link" Foreground="{DynamicResource Theme.Text}" Margin="0,0,0,7"/>
                  </WrapPanel>
                  <WrapPanel>
                    <CheckBox Name="ShareGame" Content="Show game title" Foreground="{DynamicResource Theme.Text}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <TextBlock Text="Title override" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Name="GameTitle" Width="166" MaxLength="100" ToolTip="Optional title for this session. Direct can read the title if the PS5 supplies it."/>
                  </WrapPanel>
                  <TextBlock Name="DiscordState" Foreground="{DynamicResource Theme.Muted}" Margin="0,5,0,2"/>
                  <TextBlock Foreground="{DynamicResource Theme.Muted}" Text="To broadcast, join a Discord voice channel, choose Share Your Screen → Applications → P5Cast, and enable sound."/>
                </StackPanel>
              </StackPanel>
              <StackPanel Name="PairPanel" Visibility="Collapsed">
                <TextBlock Text="Add console" Style="{StaticResource Heading}" Margin="0,0,0,2"/>
                <TextBlock Text="On your PS5, open Settings → System → Remote Play → Link Device." Foreground="{DynamicResource Theme.Muted}" Margin="0,0,0,7"/>
                <UniformGrid Name="PairFields" Columns="3">
                  <StackPanel Margin="0,0,10,6"><TextBlock Text="Console address"/><TextBox Name="PairAddress"/></StackPanel>
                  <StackPanel Margin="0,0,10,6"><TextBlock Text="PSN Account ID (Base64)"/><TextBox Name="PsnAccount"/></StackPanel>
                  <StackPanel Margin="0,0,10,6"><TextBlock Text="Link Device code"/><TextBox Name="PairCode" MaxLength="9"/></StackPanel>
                </UniformGrid>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Name="PairConsole" Content="Pair console" Style="{StaticResource Primary}"/><Button Name="CancelPair" Content="Cancel"/></StackPanel>
              </StackPanel>
              <StackPanel Name="HostPage" Visibility="Collapsed">
                <TextBlock Name="HostSettingsHeading" Style="{StaticResource SettingsHeading}"/>
                <StackPanel Name="SharingSettings">
                  <UniformGrid Name="HostFields" Columns="2">
                    <StackPanel Margin="0,0,10,6"><TextBlock Text="Listen on this network address" Margin="0,0,0,5"/><ComboBox Name="BindIP"/></StackPanel>
                    <StackPanel Margin="0,0,10,6"><TextBlock Text="Display to share" Margin="0,0,0,5"/><ComboBox Name="HostDisplay"/></StackPanel>
                  </UniformGrid>
                  <WrapPanel Margin="0,8,0,0"><Button Name="StartHost" Content="Start sharing" Style="{StaticResource Primary}"/><Button Name="StopHost" Content="Stop sharing"/><Button Name="HostStatus" Content="Check status"/></WrapPanel>
                  <TextBlock Name="HostState" Style="{StaticResource Detail}" Margin="0,4,0,0" Text="Sharing continues until you select Stop sharing."/>
                </StackPanel>
                <StackPanel Name="DevicesSettings" Visibility="Collapsed">
                  <TextBlock Text="Pair a client using its four-digit PIN" Margin="0,0,0,4"/>
                  <WrapPanel><TextBox Name="Pin" MaxLength="4" Width="86" Margin="0,0,8,0"/><Button Name="ApprovePin" Content="Approve PIN"/><Button Name="Controllers" Content="Controller driver setup &#8599;"/></WrapPanel>
                  <WrapPanel Margin="0,8,0,0"><Button Name="LoadPeers" Content="Load devices"/><ComboBox Name="Peers" DisplayMemberPath="Name" SelectedValuePath="Id" Width="166" Margin="0,0,8,0"/><Button Name="RemovePeer" Content="Revoke access"/></WrapPanel>
                </StackPanel>
              </StackPanel>
              <StackPanel Name="ClientPage" Visibility="Collapsed">
                <TextBlock Name="ClientSettingsHeading" Style="{StaticResource SettingsHeading}"/>
                <StackPanel Name="NetworkSettings">
                  <TextBlock Text="Host PC address" Margin="0,0,0,4"/>
                  <WrapPanel><TextBox Name="HostAddress" Width="215" Margin="0,0,8,0" ToolTip="Use the host's LAN or private VPN address."/><Button Name="ClientPair" Content="Pair with host"/><Button Name="ClientPlay" Style="{StaticResource Primary}" Content="Start stream"/></WrapPanel>
                  <Button Name="DirectClient" Content="Play directly from my PS5" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel Name="QualitySettings" Visibility="Collapsed">
                  <UniformGrid Name="ClientFields" Columns="3">
                    <StackPanel Margin="0,0,10,6"><TextBlock Text="Video preset" Margin="0,0,0,4"/><ComboBox Name="Quality"/></StackPanel>
                    <StackPanel Margin="0,0,10,6"><TextBlock Text="Video bitrate" Margin="0,0,0,4"/><ComboBox Name="NetworkBitrate"/></StackPanel>
                    <StackPanel Margin="0,0,10,6"><TextBlock Text="Audio output" Margin="0,0,0,4"/><ComboBox Name="NetworkAudio"/></StackPanel>
                  </UniformGrid>
                  <CheckBox Name="ClientHdr" Foreground="{DynamicResource Theme.Text}" Content="Request HDR" Margin="0,8,0,0"/>
                </StackPanel>
              </StackPanel>
              </Grid>
            </ScrollViewer>
          </DockPanel>
        </Border>
        </DockPanel></Border>
      </Grid>
      <Border Name="SidebarDrawer" Grid.Column="1" Width="0" ClipToBounds="True">
        <Grid Name="SidebarBody" HorizontalAlignment="Left">
        <Border Name="MeterHost" Background="{DynamicResource Theme.Surface}" CornerRadius="8" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" Margin="12,0,0,0"/>
        <Thumb Name="SidebarResize" Style="{StaticResource DrawerGrip}" Tag="Vertical" Width="12" HorizontalAlignment="Left" Cursor="SizeWE"
               AutomationProperties.Name="Resize performance sidebar" ToolTip="Drag or use Left and Right to resize. Enter collapses the sidebar."/>
        </Grid>
      </Border>
    </Grid>
    <Border Name="StatusFooter" Grid.Row="2" Background="{DynamicResource Theme.Panel}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,1,0,0"
            ClipToBounds="True" Visibility="{Binding Visibility, ElementName=HeaderBar}">
      <StackPanel>
        <Button Name="StatusHistoryButton" Cursor="Hand" HorizontalContentAlignment="Stretch" Padding="24,7,20,7"
                AutomationProperties.Name="Show status history" ToolTip="Show status history">
          <Button.Template><ControlTemplate TargetType="Button">
            <Border Name="StatusFace" Background="Transparent" BorderThickness="1" BorderBrush="Transparent"
                    Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="StatusFace" Property="Background" Value="{DynamicResource Theme.Hover}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="StatusFace" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate></Button.Template>
          <DockPanel LastChildFill="True">
            <Ellipse Name="Indicator" DockPanel.Dock="Left" Width="7" Height="7" Fill="{DynamicResource Theme.Accent}" Margin="0,0,10,0"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="History" FontSize="12" Foreground="{DynamicResource Theme.Muted}" VerticalAlignment="Center"/>
              <Path Name="HistoryChevron" Data="M0,4 L4,0 L8,4" Stroke="{DynamicResource Theme.Muted}" StrokeThickness="1.5"
                    Margin="7,0,0,0" VerticalAlignment="Center" RenderTransformOrigin=".5,.5"><Path.RenderTransform><RotateTransform/></Path.RenderTransform></Path>
            </StackPanel>
            <Grid Height="23" ClipToBounds="True">
              <TextBlock Name="PreviousStatus" Opacity="0" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Text}" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"><TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform></TextBlock>
              <TextBlock Name="Status" Text="Ready" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Text}" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"><TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform></TextBlock>
            </Grid>
          </DockPanel>
        </Button>
      </StackPanel>
    </Border>
    <Grid Name="StatusHistoryLayer" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="12" Visibility="Collapsed"
          Background="{DynamicResource Theme.Scrim}" FocusManager.IsFocusScope="True" KeyboardNavigation.TabNavigation="Cycle"
          KeyboardNavigation.ControlTabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Contained" AutomationProperties.Name="Status history">
        <Border Name="StatusHistorySheet" MaxWidth="540" MaxHeight="360" Margin="18" Padding="20" VerticalAlignment="Center" CornerRadius="14"
                Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1">
          <Grid MaxHeight="290"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Margin="2,0,0,4">
              <Button Name="CloseStatusHistory" DockPanel.Dock="Right" Width="34" MinWidth="34" Height="30" Style="{StaticResource TitleAction}"
                      AutomationProperties.Name="Close status history" ToolTip="Close status history (Esc)">
                <Path Data="M2,2 L12,12 M12,2 L2,12" Stroke="{DynamicResource Theme.Muted}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              </Button>
              <TextBlock Text="Status history" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Text}" VerticalAlignment="Center"/>
            </DockPanel>
            <ListBox Grid.Row="1" Name="StatusHistoryList" AutomationProperties.Name="Status history" Background="Transparent"
                     Foreground="{DynamicResource Theme.Text}" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListBox.Template><ControlTemplate TargetType="ListBox">
                <ScrollViewer Name="HistoryScroll" Style="{StaticResource {x:Type ScrollViewer}}"
                              CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsPresenter/>
                </ScrollViewer>
              </ControlTemplate></ListBox.Template>
              <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="2,5"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                  <Border Name="Row" Padding="{TemplateBinding Padding}" CornerRadius="4"><ContentPresenter/></Border>
                  <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Theme.Hover}"/>
                  </Trigger></ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
              </Style></ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate><DataTemplate>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding ClockTime}" FontSize="12" Foreground="{DynamicResource Theme.Muted}" MinWidth="76" Margin="0,1,12,0" ToolTip="{Binding Timestamp}"/>
                  <TextBlock Grid.Column="1" Text="Error" Margin="0,0,8,0" Foreground="{DynamicResource Theme.Error}" FontWeight="SemiBold" FontSize="13">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers><DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                    </Style></TextBlock.Style>
                  </TextBlock>
                  <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="13" TextWrapping="Wrap"/>
                </Grid>
              </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
    </Grid>
    <Grid Name="StopPanel" Grid.Row="1" Grid.RowSpan="2" Panel.ZIndex="11" Visibility="Collapsed"
          Background="{DynamicResource Theme.Scrim}" AutomationProperties.Name="Disconnect confirmation" FocusManager.IsFocusScope="True"
          KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Contained">
      <Border MaxWidth="432" Margin="18" Padding="22" HorizontalAlignment="Stretch" VerticalAlignment="Center"
              CornerRadius="14" Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <StackPanel>
            <TextBlock Name="StopTitle" Text="Stop playing?" TextWrapping="Wrap" Foreground="{DynamicResource Theme.Text}"
                       FontWeight="SemiBold" FontSize="23" Margin="0,0,0,16" Focusable="True" KeyboardNavigation.IsTabStop="False"/>
            <CheckBox Name="RestOnStop" Content="Put PS5 into rest mode" Margin="0,0,0,10"/>
            <CheckBox Name="RememberStop" Content="Remember my choice for this console" Margin="0,0,0,4"/>
            <TextBlock Name="StopMessage" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                       Foreground="{DynamicResource Theme.Muted}" Margin="0,10,0,0"/>
            <WrapPanel HorizontalAlignment="Right" Margin="0,16,0,0">
              <Button Name="CancelStop" Content="Keep playing"/><Button Name="ConfirmStop" Content="Stop session" Margin="0" Style="{StaticResource Primary}"/>
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <Grid Name="SetupOverlay" Grid.Row="1" Grid.RowSpan="2" Panel.ZIndex="10" Visibility="Collapsed"
          Background="{DynamicResource Theme.Scrim}" FocusManager.IsFocusScope="True" AutomationProperties.Name="P5Cast setup"
          KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Contained">
      <Grid.Resources>
        <Style x:Key="SetupLabel" TargetType="Label">
          <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/><Setter Property="FontWeight" Value="SemiBold"/>
          <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,12,0,5"/>
        </Style>
        <Style x:Key="SetupHint" TargetType="TextBlock" BasedOn="{StaticResource Detail}">
          <Setter Property="FontSize" Value="12"/><Setter Property="LineHeight" Value="17"/><Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
      </Grid.Resources>
      <Border MaxWidth="568" MaxHeight="630" Margin="16,12" HorizontalAlignment="Stretch" VerticalAlignment="Center"
              CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource Theme.Border}" Background="{DynamicResource Theme.Surface}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Margin="22,16,22,12">
            <TextBlock Name="SetupStep" Text="Step 1 of 3" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Accent}"/>
            <TextBlock Name="SetupTitle" Text="Choose your display" FontSize="25" FontWeight="SemiBold" Margin="0,3,0,0"
                       Focusable="True" KeyboardNavigation.IsTabStop="False"/>
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid Margin="22,0,22,16">
              <StackPanel Name="SetupDisplayPage">
                <Label Style="{StaticResource SetupLabel}" Margin="0,0,0,5" Target="{Binding ElementName=SetupDisplay}" Content="Playback monitor"/>
                <ComboBox Name="SetupDisplay" AutomationProperties.Name="Playback monitor"/>
                <Label Style="{StaticResource SetupLabel}" Target="{Binding ElementName=SetupColor}" Content="Color output"/>
                <ComboBox Name="SetupColor" AutomationProperties.Name="Color output"/>
                <TextBlock Name="SetupDisplayHint" Style="{StaticResource SetupHint}" Text="Auto follows the selected monitor’s Windows HDR setting."/>
                <Label Style="{StaticResource SetupLabel}" Target="{Binding ElementName=SetupRenderer}" Content="Graphics API"/>
                <ComboBox Name="SetupRenderer" AutomationProperties.Name="Graphics API"/>
                <TextBlock Name="SetupRendererHint" Style="{StaticResource SetupHint}" Text="This choice determines which GPU effects and color outputs are available."/>
                <Label Style="{StaticResource SetupLabel}" Target="{Binding ElementName=SetupStream}" Content="PS5 stream resolution"/>
                <ComboBox Name="SetupStream" AutomationProperties.Name="PS5 stream resolution"/>
                <TextBlock Style="{StaticResource SetupHint}" Text="Choose the picture size to request from the console. Upscaling is available separately in Picture."/>
              </StackPanel>
              <StackPanel Name="SetupConsolePage" Visibility="Collapsed">
                <Label Style="{StaticResource SetupLabel}" Margin="0,0,0,5" Target="{Binding ElementName=SetupConsole}" Content="Paired console"/>
                <ComboBox Name="SetupConsole" AutomationProperties.Name="Paired console"/>
                <TextBlock Name="SetupConsoleHint" Style="{StaticResource SetupHint}" Text="Use a saved console, add another one, or continue and pair later."/>
                <Button Name="SetupAdd" Content="Add a console" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                <StackPanel Name="SetupPairForm" Visibility="Collapsed">
                  <TextBlock Style="{StaticResource Detail}" Margin="0,12,0,0">
                    On your PS5, open <Run FontWeight="SemiBold" Text="Settings → System → Remote Play"/>. Turn on <Run FontWeight="SemiBold" Text="Enable Remote Play"/>, then select <Run FontWeight="SemiBold" Text="Link Device"/>.
                  </TextBlock>
                  <Label Style="{StaticResource SetupLabel}" Target="{Binding ElementName=SetupAddress}" Content="PS5 IP address"/>
                  <TextBox Name="SetupAddress" AutomationProperties.Name="PS5 IP address"/>
                  <TextBlock Style="{StaticResource SetupHint}" Text="If your console is on another subnet, enter its reachable IP address. Find it under Settings → Network → Connection Status → View Connection Status."/>
                  <Label Style="{StaticResource SetupLabel}" Target="{Binding ElementName=SetupAccount}" Content="PSN account ID (Base64)"/>
                  <TextBox Name="SetupAccount" AutomationProperties.Name="Base64 PSN account ID"/>
                  <TextBlock Style="{StaticResource SetupHint}" Text="Use the eight-byte account ID for the PS5 user, encoded in Base64."/>
                  <Button Name="SetupAccountHelp" Content="Find my account ID ↗" AutomationProperties.Name="Open the PSN account ID guide"
                          HorizontalAlignment="Left" Padding="5,2" MinHeight="26" Margin="0,3,0,0" Foreground="{DynamicResource Theme.Accent}" Background="Transparent" BorderBrush="Transparent"/>
                  <Label Style="{StaticResource SetupLabel}" Target="{Binding ElementName=SetupCode}" Content="Eight-digit link code"/>
                  <WrapPanel>
                    <TextBox Name="SetupCode" MaxLength="9" Width="148" Margin="0,0,8,0" AutomationProperties.Name="Eight-digit Link Device code"/>
                    <Button Name="SetupPair" Content="Pair console" VerticalAlignment="Center" Margin="0"/>
                  </WrapPanel>
                </StackPanel>
              </StackPanel>
              <StackPanel Name="SetupFinishPage" Visibility="Collapsed">
                <Border Background="{DynamicResource Theme.Panel}" BorderThickness="1" BorderBrush="{DynamicResource Theme.Border}" CornerRadius="8" Padding="14,11">
                  <TextBlock Name="SetupSummary" Foreground="{DynamicResource Theme.Text}" LineHeight="22" TextWrapping="Wrap"/>
                </Border>
                <TextBlock Name="SetupFinishHint" Style="{StaticResource Detail}" Margin="0,12,0,0" Text="Press Play in the main window to connect. You can change these choices in Play settings."/>
              </StackPanel>
            </Grid>
          </ScrollViewer>
          <TextBlock Grid.Row="2" Name="SetupMessage" AutomationProperties.LiveSetting="Polite" Foreground="{DynamicResource Theme.Generated}" TextWrapping="Wrap" Margin="22,0,22,10">
            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
              <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
          <Border Grid.Row="3" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Button Name="SetupSkip" Content="Skip setup" HorizontalAlignment="Left" Margin="0" Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource Theme.Muted}"/>
              <Button Name="SetupBack" Grid.Column="1" Content="Back" Margin="0,0,6,0"/>
              <Button Name="SetupNext" Grid.Column="2" Content="Next" Style="{StaticResource Primary}" Margin="0" MinWidth="74"/>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>
    </Grid>
  </Grid>
</Window>
