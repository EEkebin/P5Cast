<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="P5Cast Player" Background="Black" Width="960" Height="582" MinWidth="320" MinHeight="200"
        UseLayoutRounding="True" WindowStartupLocation="CenterScreen">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <DockPanel>
    <DockPanel Name="PlayerHeader" DockPanel.Dock="Top" Height="40" Background="{DynamicResource Theme.Surface}" LastChildFill="True">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Button Name="DockVideo" Style="{DynamicResource TitleAction}" Content="Dock" ToolTip="Return video to the dashboard"/>
        <Button Name="PlayerFullscreen" Style="{DynamicResource TitleAction}" ToolTip="Fullscreen video (F11)" AutomationProperties.Name="Fullscreen">
          <Path Data="M0,4 V0 H4 M9,0 H13 V4 M13,8 V12 H9 M4,12 H0 V8" Stroke="{DynamicResource Theme.Text}" StrokeThickness="1.4"/>
        </Button>
        <Button Name="PlayerMinimize" Style="{DynamicResource TitleAction}" ToolTip="Minimize" AutomationProperties.Name="Minimize">
          <Path Data="M0,5 H11" Stroke="{DynamicResource Theme.Muted}" StrokeThickness="1.3"/>
        </Button>
        <Button Name="PlayerClose" Style="{DynamicResource TitleAction}" ToolTip="Close player and dock video" AutomationProperties.Name="Close player">
          <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{DynamicResource Theme.Text}" StrokeThickness="1.3"/>
        </Button>
      </StackPanel>
      <TextBlock Text="P5Cast Player" Margin="14,0" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Text}" FontWeight="SemiBold"/>
    </DockPanel>
    <Border Name="PlayerSurface" ClipToBounds="True" Background="Black"/>
  </DockPanel>
</Window>
