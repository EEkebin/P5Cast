 CHIAKI_EXPORT ChiakiErrorCode chiaki_stop_pipe_connect(ChiakiStopPipe *stop_pipe, chiaki_socket_t fd, struct sockaddr *addr, size_t addrlen, uint64_t timeout_ms)
 {
+#ifdef _WIN32
+	WSAEVENT events[2] = { stop_pipe->event, WSACreateEvent() };
+	if(events[1] == WSA_INVALID_EVENT)
+		return CHIAKI_ERR_UNKNOWN;
+
+	ChiakiErrorCode result = CHIAKI_ERR_UNKNOWN;
+	if(WSAEventSelect(fd, events[1], FD_CONNECT) == 0)
+	{
+		int error = 0;
+		if(connect(fd, addr, (int)addrlen) == SOCKET_ERROR)
+			error = WSAGetLastError();
+		if(error == WSAEWOULDBLOCK)
+		{
+			DWORD wait = WSAWaitForMultipleEvents(2, events, FALSE,
+					timeout_ms == UINT64_MAX ? WSA_INFINITE : (DWORD)timeout_ms, FALSE);
+			if(wait == WSA_WAIT_EVENT_0)
+				result = CHIAKI_ERR_CANCELED;
+			else if(wait == WSA_WAIT_TIMEOUT)
+				result = CHIAKI_ERR_TIMEOUT;
+			else if(wait == WSA_WAIT_EVENT_0 + 1)
+			{
+				WSANETWORKEVENTS network;
+				if(WSAEnumNetworkEvents(fd, events[1], &network) == 0 && (network.lNetworkEvents & FD_CONNECT))
+					error = network.iErrorCode[FD_CONNECT_BIT];
+			}
+		}
+		switch(error)
+		{
+			case 0: result = CHIAKI_ERR_SUCCESS; break;
+			case WSAECONNREFUSED: result = CHIAKI_ERR_CONNECTION_REFUSED; break;
+			case WSAETIMEDOUT: result = CHIAKI_ERR_TIMEOUT; break;
+			case WSAEHOSTDOWN: result = CHIAKI_ERR_HOST_DOWN; break;
+			case WSAEHOSTUNREACH: result = CHIAKI_ERR_HOST_UNREACH; break;
+			case WSAEWOULDBLOCK: break; // Wait canceled, timed out, or failed.
+			default: result = CHIAKI_ERR_NETWORK; break;
+		}
+		WSAEventSelect(fd, NULL, 0);
+	}
+	WSACloseEvent(events[1]);
+	return result;
+#else
 	int r = connect(fd, addr, (socklen_t)addrlen);
 	if(r >= 0)
 		return CHIAKI_ERR_SUCCESS;
@@ -253,6 +294,7 @@
 			return CHIAKI_ERR_UNKNOWN;
 	}
 #endif
+#endif
 }
 
